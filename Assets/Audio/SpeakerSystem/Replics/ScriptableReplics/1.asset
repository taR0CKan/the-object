  dialogueName: "\u0420\u0435\u043F\u043B\u0438\u043A\u0430 2 \u043A\u043E\u043C\u043D\u0430\u0442\u044B"
  text: "\u0412\u0430\u043C \u043F\u0440\u0438\u0434\u0435\u0442\u0441\u044F \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u0441\u043E \u0441\u0442\u0430\u0446\u0438\u043E\u043D\u0430\u0440\u043D\u044B\u043C\u0438
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430\u043C\u0438. \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,\r\n\u043F\u0440\u043E\u0441\u043B\u0443\u0448\u0430\u0439\u0442\u0435
    \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0438\u0435 \u0438\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438
    \u0447\u0435\u0440\u0435\u0437 \u0442\u0435\u043B\u0435\u0444\u043E\u043D.\r"
