  dialogueName: "\u0420\u0435\u043F\u043B\u0438\u043A\u0430 1 \u043A\u043E\u043C\u043D\u0430\u0442\u044B"
  text: "\u041D\u0430\u0447\u043D\u0435\u043C \u0441 \u043F\u0440\u043E\u0441\u0442\u043E\u0433\u043E
    \u0438 \u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0433\u043E. \u0422\u0435\u0445\u043D\u0438\u043A\u0430
    \u043D\u0430 \u043E\u0431\u044A\u0435\u043A\u0442\u0430\u0445 \u043C\u043E\u0436\u0435\u0442
    \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u0442\u044C \u0438\u043D\u0430\u0447\u0435,
    \u043D\u043E\r\n\u0441\u0443\u0442\u044C \u0442\u0430 \u0436\u0435. \u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
    \u043D\u0430 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442 \u043D\u0430 \u0441\u0442\u043E\u043B\u0435
    \u0438 \u0432\u0432\u0435\u0434\u0438\u0442\u0435 \u0441\u043B\u043E\u0432\u043E
    \u0441 \u043D\u0435\u0433\u043E \u0432 \u043A\u043E\u043C\u043F\u044C\u044E\u0442\u0435\u0440.\r"
