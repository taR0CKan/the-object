    - target: {fileID: 4149639406921419503, guid: 7a30dacafdd8f0d44a5af0b9219c9cf6, type: 3}
      propertyPath: m_text
      value: "<u>\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435:</u>
        <line-height=80%>\n    W/A/S/D - \u043F\u0435\u0440\u0435\u043C\u0435\u0449\u0435\u043D\u0438\u0435\n   
        Mouse - \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C\u0441\u044F\n   
        \u0415/Esc - \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435/\u043E\u0442-\u043C\u0435\u043D\u0430\n   
        1-4 - \u044F\u0447\u0435\u0439\u043A\u0438 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044F\n   
        G - \u0432\u044B\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u0440\u0435\u0434\u043C\u0435\u0442\n   
        C - \u043F\u0440\u0438\u0441\u0435\u0434\n\n <u>\u0418\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438:</u>\n    
        \u0414\u0435\u043B\u0430\u0439 \u0432\u0441\u0435, \u0447\u0442\u043E \u044F
        \u0441\u043A\u0430\u0436\u0443. \u041D\u0438\u0447\u0442\u043E \u043D\u0435
        \u043C\u043E\u0436\u0435\u0442 \u043D\u0430\u0432\u0440\u0435\u0434\u0438\u0442\u044C
        \u0442\u0435\u0431\u0435 \u0437\u0434\u0435\u0441\u044C."
      objectReference: {fileID: 0}
