    - target: {fileID: 4149639406921419503, guid: 7a30dacafdd8f0d44a5af0b9219c9cf6, type: 3}
      propertyPath: m_text
      value: "<u>\u0417\u0430\u0434\u0430\u0447\u0438:</u> <line-height= 60%>\n   
        - \u0412\u0437\u044F\u0442\u044C \u043A\u0430\u0440\u0442\u043E\u0447\u043A\u0443
        \u0433\u043E\u0441\u0442\u044F; \n    -  \u0412\u0432\u0435\u0441\u0442\u0438
        \u0438\u043C\u044F \u0433\u043E\u0441\u0442\u044F \u0432 \u041F\u041A;\n   
        -  \u041E\u0442\u043A\u0440\u044B\u0442\u044C \u043A\u043B\u044E\u0447\u043E\u043C
        \u0441\u043E\u043E\u0442-\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0443\u044E
        \u0434\u0432\u0435\u0440\u044C.\n<u>\u0410\u043D\u043E\u043C\u0430\u043B\u0438\u0438:</u>\n   
        - \u041F\u043E\u0442\u0435\u0440\u044F \u043A\u043B\u044E\u0447\u0435\u0439:
        \u043D\u0443, \u0443\u0433\u0430\u0434\u0430\u0439?\n    - \u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430:
        \u043F\u0440\u044F\u0447\u044C\u0441\u044F \u0437\u0430 \u0441\u0442\u043E-
        \u043B\u0438\u043A\u043E\u043C \u0434\u043E \u043E\u043A\u043E\u043D\u0447\u0430\u043D\u0438\u044F
        \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438;\n    - \u041F\u0440\u043E\u0441\u044C\u0431\u0430
        \u0433\u043E\u0441\u0442\u044F: \u043F\u0440\u0438\u043D\u0435\u0441\u0438
        \u0438\u0437 \u043F\u043E\u0434\u0441\u043E\u0431\u043A\u0438 \u0437\u0430\u043F\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0439
        \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0422\u041E\u041B\u042C\u041A\u041E
        \u0435\u0441\u043B\u0438 \u043A\u043E\u043C\u043D\u0430\u0442\u0430 \u0438
        \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0432 \u043D\u0430\u043B\u0438\u0447\u0438\u0438.\n    "
      objectReference: {fileID: 0}
